# Configurazione API Gemini
# Rinomina questo file in .env e inserisci la tua API key

# Ottieni la tua API key gratuita da: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=inserisci_qui_la_tua_chiave_api

# IMPORTANTE: Non condividere mai la tua API key!
# Aggiungi .env al .gitignore per non caricarla su GitHub
